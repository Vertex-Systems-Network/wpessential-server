{
    "name": "vertex-systems-network/wpessential-server",
    "description": "WPE Server: licences, subscriptions, trials, payments and the demo library for wpessential.org (WooCommerce).",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.13.6",
        "wp-coding-standards/wpcs": "^3.4.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload-dev": {
        "psr-4": {
            "WPEssential\\Server\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs -q --standard=phpcs.xml.dist src wpessential-server.php",
        "zip": "@php tools/build-zip.php"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    }
}
